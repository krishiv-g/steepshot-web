{
  "name": "steepshot-web",
  "version": "0.0.7",
  "repository": {
    "type": "git"
  },
  "license": "MIT",
  "scripts": {
    "start": "NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "build": "NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "node ./configs/server.js --app ./src/app.js --template template.js",
    "redeploy": "npm run build && npm run server",
    "https": "HTTPS=true npm run start",
    "docker:build": "docker build -t steepshot-web .",
    "docker:run": "docker-compose up",
    "docker:stop": "docker-compose down"
  },
  "dependencies": {
    "create-react-server": "^0.3.2",
    "dompurify": "^3.2.2",
    "golos-js": "^0.7.7",
    "history": "^5.3.0",
    "image-compressor.js": "^1.1.4",
    "react": "^18.3.1",
    "react-copy-to-clipboard": "^5.1.0",
    "react-custom-scrollbars": "^4.2.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-player": "^2.16.0",
    "react-rangeslider": "^2.2.0",
    "react-redux": "^9.2.0",
    "react-resize-detector": "^12.0.0",
    "react-router-dom": "^6.28.0",
    "react-share": "^5.2.2",
    "redux": "^5.0.1",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^3.1.0",
    "remark-gfm": "^4.0.0",
    "sc2-sdk": "^2.0.1",
    "steem": "^0.7.11",
    "styled-components": "^6.1.19",
    "styled-is": "^1.3.0",
    "timeago-react": "^3.0.7"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "babel-plugin-styled-components": "^2.1.4",
    "prop-types": "^15.8.1",
    "react-scripts": "4.0.3",
    "typescript": "^5.7.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
